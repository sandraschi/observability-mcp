# Point observability-mcp at the unified PLG stack (mcp-central-docs/monitoring).
# Copy to .env — do NOT run observability-mcp/docker-compose.yml on 3000/9091/3100.

GRAFANA_URL=http://127.0.0.1:12000
GRAFANA_USER=admin
GRAFANA_PASS=admin

LOKI_URL=http://127.0.0.1:12002

# Prometheus server (queries, /-/healthy) — NOT the MCP process metrics port
PROMETHEUS_SERVER_URL=http://127.0.0.1:12001

# observability-mcp own ports (12000 band — after unified PLG 12000–12006)
PROMETHEUS_PORT=12009
MCP_PORT=12007
# Web UI (Vite): 12008 — set in web_sota/start.ps1 or VITE_* in web_sota/.env
